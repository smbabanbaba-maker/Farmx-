# Browser-safe values only
VITE_API_BASE_URL=https://api.example.com
VITE_PAYSTACK_PUBLIC_KEY=pk_live_replace_me
VITE_COGNITO_USER_POOL_ID=eu-west-1_example
VITE_COGNITO_WEB_CLIENT_ID=examplewebclientid
# Optional Hosted UI variables for real Google/Facebook sign-in.
# The identity provider must also be enabled in Cognito and the callback URI allowlisted.
VITE_COGNITO_HOSTED_UI_DOMAIN=your-domain.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=https://your-farmx-domain.example/oauth/callback

# Server-only values. Set these in the production runtime, not in browser build settings.
AWS_REGION=eu-west-1
FARMX_MEDIA_BUCKET=farmx-production-media-example
FARMX_LISTINGS_TABLE=farmx-production-listings-example
FARMX_PROFILE_TABLE=farmx-production-profiles-example
FARMX_COMMUNITY_TABLE=farmx-production-community-example
FARMX_LEARN_TABLE=farmx-production-learn-example
FARMX_PAYSTACK_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:123456789012:secret:farmx/production/paystack-example
COGNITO_USER_POOL_ID=eu-west-1_example
COGNITO_WEB_CLIENT_ID=examplewebclientid

# Store the payment secret in AWS Secrets Manager. Do not add it to this file.
# PAYSTACK_SECRET_KEY=
# FARMX_PAYMENT_CALLBACK_URL=https://your-farmx-domain.example/payment/callback
# FARMX_SERVICE_PACKAGES_JSON='[{"id":"boost","label":"Boost Listing","description":"Increase visibility in relevant marketplace results.","requiresListing":true,"packages":[{"id":"boost-7","durationDays":7,"amount":5000,"currency":"NGN"}]}]'

# Public SEO configuration. Keep indexing disabled until the production public API and domain are ready.
VITE_PUBLIC_SITE_URL=https://farmx.ng
VITE_PUBLIC_INDEXING=false
# Set VITE_PUBLIC_INDEXING=true only for the production deployment that serves real public data.
